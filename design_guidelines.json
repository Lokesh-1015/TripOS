    "primary": "#174C3C",
    "primary_hover": "#1E5E4B",
    "accent": "#F28B68",
    "on_accent": "#FFFFFF",
    "border_subtle": "#E5E9E4",
    "border_focus": "#174C3C"
  },
  "typography": {
    "font_family_heading": "Plus Jakarta Sans Variable, sans-serif",
    "font_family_body": "Plus Jakarta Sans Variable, sans-serif",
    "font_family_mono": "Geist Mono Variable, monospace",
    "css_import": "@import \"@fontsource-variable/plus-jakarta-sans\"; @import \"@fontsource-variable/geist-mono\";",
    "scale_px": {
      "display": 56,
      "h1": 40,
      "h2": 30,
      "h3": 22,
      "h4": 18,
      "body": 15,
      "caption": 13
    },
    "letter_spacing": {
      "display": "-0.03em",
      "heading": "-0.02em",
      "overline": "0.15em",
      "body": "0.005em"
    }
  },
  "entry_surfaces": {
    "/": "split hero landing — bold brand value + interactive travel preview left, live interactive interactive trip card & quick action right",
    "/login": "split auth — brand positioning with trip stats panel left, clean login card right",
    "/signup": "split auth — workspace onboarding preview left, clean multi-step registration form right",
    "/app": "sidebar-driven command workspace — collapsible dark forest sidebar left, responsive multi-tab trip canvas right"
  },
  "layouts": {
    "desktop": {
      "type": "sidebar_canvas",
      "sidebar_width": "260px",
      "canvas_max_width": "1440px",
      "content_padding": "p-6 lg:p-8"
    },
    "mobile": {
      "type": "bottom_nav_sheet",
      "nav_height": "64px",
      "content_padding": "p-4"
    },
    "border_radius": {
      "cards": "rounded-2xl",
      "buttons": "rounded-xl",
      "inputs": "rounded-xl",
      "chips": "rounded-full"
    }
  },
  "motion": {
    "standard_transition": "transition-all duration-200 ease-out",
    "modal_animation": "animate-in fade-in-50 zoom-in-95 duration-200",
    "tab_transition": "transition-opacity duration-150 ease-in-out"
  },
  "accessibility": {
    "contrast_standard": "WCAG AA (minimum 4.5:1 for body copy on both page and sidebar)",
    "data_testid_convention": "kebab-case functional identifiers on every button, input, tab, poll option, expense row, and modal action"
  },
