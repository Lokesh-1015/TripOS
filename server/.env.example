# Local Postgres from ../docker-compose.yml. Copy to .env; use real secrets outside local dev.
DATABASE_URL=postgresql://tripos:tripos_dev@localhost:5434/tripos
PORT=4000
# Comma-separated browser origins allowed to call the API directly. Empty in dev: Vite proxies /api.
CORS_ORIGINS=
APP_URL=http://localhost:3000
# Any SMTP provider. Locally, Mailpit (docker-compose) catches everything: open http://localhost:8025
SMTP_URL=smtp://localhost:1025
MAIL_FROM=TripOS <hello@tripos.local>
# Local testing only: lets the test suites create many accounts. Ignored in production.
THROTTLE_DISABLED=true
