# Local Postgres from ../docker-compose.yml. Copy to .env; use real secrets outside local dev.
DATABASE_URL=postgresql://tripos:tripos_dev@localhost:5434/tripos
PORT=4000
# Comma-separated browser origins allowed to call the API directly. Empty in dev: Vite proxies /api.
CORS_ORIGINS=
APP_URL=http://localhost:3000
UPLOAD_DIR=uploads
