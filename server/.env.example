# Local Postgres from ../docker-compose.yml. Copy to .env; use real secrets outside local dev.
DATABASE_URL=postgresql://tripos:tripos_dev@localhost:5434/tripos
PORT=4000
# Comma-separated browser origins allowed to call the API directly. Empty in dev: Vite proxies /api.
CORS_ORIGINS=
APP_URL=http://localhost:3000
# Locally, Mailpit (docker-compose) catches everything: open http://localhost:8025
SMTP_URL=smtp://localhost:1025
# Production sends through Brevo instead, because Render's free plan blocks SMTP. Takes priority over SMTP_URL.
# BREVO_API_KEY=
MAIL_FROM=TripOS <hello@tripos.local>
# Lets the scheduled workflow run the daily reminders. Use a long random value in production, set on Render and in GitHub.
JOBS_SECRET=local-test-secret
# Local testing only: test suites send far more email than Brevo's free daily 300. Leave unset in production.
MAIL_OPTIONAL_ALLOWANCE=100000
# Sign in with Google: the client id from Google Cloud. It's public, and there's no client secret. Leave unset to hide the button.
# GOOGLE_CLIENT_ID=
# Local testing only, and ignored in production: addresses here skip the real-email checks and confirmation,
# and browser tests can sign in with Google using made-up tokens.
EMAIL_CHECK_SKIP_DOMAINS=example.test
GOOGLE_TEST_TOKENS=true
# Where uploaded files go. Without these they're kept in the database. Neon Object Storage: the branch's S3 endpoint and a storage credential.
# OBJECT_STORAGE_ENDPOINT=
# OBJECT_STORAGE_REGION=ap-southeast-1
# OBJECT_STORAGE_BUCKET=tripos-files
# OBJECT_STORAGE_ACCESS_KEY=
# OBJECT_STORAGE_SECRET_KEY=
# Where contact form messages and reports go. Without this, they go to the MAIL_FROM address.
# OWNER_EMAIL=
# Local testing only: lets the test suites create many accounts. Ignored in production.
THROTTLE_DISABLED=true
